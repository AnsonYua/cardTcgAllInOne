{
  "watch": [
    "src/**/*",
    "server.ts"
  ],
  "ext": "ts,js,json",
  "ignore": [
    "dist/**/*",
    "node_modules/**/*",
    "src/tests/**/*",
    "src/gameData/**/*",
    "*.test.ts",
    "*.test.js"
  ],
  "exec": "ts-node server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true
}