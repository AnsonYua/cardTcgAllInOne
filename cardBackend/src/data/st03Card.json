                            {
                                "type": "paired"
                            }
                        ],
                        "timing": {
                            "duration": "continuous"
                        },
                        "target": {
                            "type": "unit",
                            "scope": "self",
                            "count": 1
                        },
                        "parameters": {
                            "keyword": "High-Maneuver",
                            "notes": "Unblockable keyword not yet implemented."
                        }
                    },
                    {
                        "effectId": "shield_destroy_damage_2",
                        "type": "triggered",
                        "trigger": "DEFENSE_AREA_BATTLE_DAMAGE",
                        "action": "damage",
                        "timing": {
                            "actionTurn": "YOUR_TURN"
                        },
                        "target": {
                            "type": "unit",
                            "scope": "opponent",
                            "count": 1
                        },
                        "parameters": {
                            "value": 2,
                            "source": "battle_damage",
                            "defenseAreas": [
                                "shield",
                                "base"
                            ],
                            "notes": "Triggers when this Unit deals battle damage to a card in the opponent's shield area or to an enemy Base (Base does not need to be destroyed). Engine trigger not implemented yet."
                        }
                    }
                ]
            }
        },
